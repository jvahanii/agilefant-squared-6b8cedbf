exports[`live updates > open these channels, each listening to these tables 1`] = `
{
  "entity-realtime-org": [
    "backlog_scrambles",
    "backlog_statuses",
    "backlog_trees [organization_id=eq.org]",
    "backlogs [organization_id=in.(org,out,partner)]",
    "jira_connections",
    "jira_issue_links",
    "label_assignments [organization_id=in.(org,out,partner)]",
    "labels [organization_id=in.(org,out,partner)]",
    "organization_settings [organization_id=eq.org]",
    "published_links",
    "teams [organization_id=in.(org,out,partner)]",
    "time_entries [organization_id=in.(org,out,partner)]",
    "tree_financial_targets",
    "work_item_backlog_ranks [organization_id=in.(org,out,partner)]",
    "work_item_board_ranks [organization_id=in.(org,out,partner)]",
    "work_item_financials [organization_id=in.(org,out,partner)]",
    "work_item_hyperlinks [organization_id=in.(org,out,partner)]",
    "work_item_scrambles",
    "work_item_team_assignments [organization_id=in.(org,out,partner)]",
    "work_items [organization_id=in.(org,out,partner)]",
  ],
  "work-item-snoozes-me": [
    "work_item_snoozes [user_id=eq.me]",
  ],
}
`;
