exports[`the Gmail function > imports links: into one list, or split by deadline, keeping what the picker knew 1`] = `
{
  "jobs": {
    "body": {
      "collapsed": 0,
      "created": 2,
      "createdByUrl": {},
      "createdIds": [
        "b-0",
        "b-1",
      ],
      "opts": {
        "allowDuplicates": true,
        "backlogId": "b",
        "fetchDeadlines": true,
        "organizationId": "org-1",
        "queryId": null,
        "treeId": "t",
      },
      "skipped": 0,
    },
    "db": [
      "memberships: select(id) eq(user_id,user-1) eq(organization_id,org-1)",
    ],
    "gmail": [],
    "status": 200,
  },
  "noLinks": {
    "body": {
      "error": "links is required",
    },
    "db": [],
    "gmail": [],
    "status": 400,
  },
  "noTree": {
    "body": {
      "error": "organizationId, treeId and backlogId are required",
    },
    "db": [],
    "gmail": [],
    "status": 400,
  },
  "split": {
    "body": {
      "collapsed": 0,
      "created": 2,
      "createdByUrl": {},
      "createdIds": [
        "dated-0",
        "dated-1",
      ],
      "dated": 2,
      "skipped": 0,
      "undated": 0,
    },
    "db": [
      "memberships: select(id) eq(user_id,user-1) eq(organization_id,org-1)",
    ],
    "gmail": [],
    "status": 200,
  },
}
`;

