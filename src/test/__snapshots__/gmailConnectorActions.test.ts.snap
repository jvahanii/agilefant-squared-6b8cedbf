    ],
    "gmail": [],
    "status": 200,
  },
}
`;

exports[`the Gmail function > says whether this user is connected, and how the organisation reaches Gmail 1`] = `
{
  "own": {
    "body": {
      "connected": true,
      "email": "me@example.com",
      "oauth": {
        "canManage": false,
        "clientId": "c.apps.googleusercontent.com",
        "configured": true,
        "mode": "own",
        "updatedAt": "2026-01-01",
      },
      "updatedAt": "2026-01-01",
    },
    "db": [
      "memberships: select(id) eq(user_id,user-1) eq(organization_id,org-1)",
      "gmail_connections: select(connected_email, updated_at) eq(user_id,user-1) eq(organization_id,org-1)",
      "memberships: select(role) eq(user_id,user-1) eq(organization_id,org-1)",
    ],
    "gmail": [],
    "status": 200,
  },
  "shared": {
    "body": {
      "connected": true,
      "email": "me@example.com",
      "oauth": {
        "mode": "shared",
      },
      "updatedAt": "2026-01-01",
    },
    "db": [
      "memberships: select(id) eq(user_id,user-1) eq(organization_id,org-1)",
      "gmail_connections: select(connected_email, updated_at) eq(user_id,user-1) is(organization_id,object)",
    ],
    "gmail": [],
    "status": 200,
  },
}
`;

exports[`the Gmail function > sets and removes the organisation's own client, for its owners and admins only 1`] = `
{
  "changed": {
    "body": {
      "clientId": "123456789012-abc123.apps.googleusercontent.com",
      "configured": true,
    },
    "db": [
      "memberships: select(role) eq(user_id,user-1) eq(organization_id,org-1)",
      "organization_google_oauth_clients: upsert(object,object)",
      "gmail_connections: delete() eq(organization_id,org-1)",
    ],
    "gmail": [],
    "status": 200,
  },
  "member": {
    "body": {
      "error": "forbidden: only an owner or admin can set this organization's Google OAuth client",
    },
    "db": [
      "memberships: select(role) eq(user_id,user-1) eq(organization_id,org-1)",
    ],
    "gmail": [],
    "status": 403,
  },
  "noSecret": {
    "body": {
      "error": "The client secret is required.",
    },
    "db": [
      "memberships: select(role) eq(user_id,user-1) eq(organization_id,org-1)",
    ],
    "gmail": [],
    "status": 400,
  },
  "notAClientId": {
    "body": {
      "error": "That does not look like a Google OAuth client ID. It ends in .apps.googleusercontent.com.",
    },
    "db": [
      "memberships: select(role) eq(user_id,user-1) eq(organization_id,org-1)",
    ],
    "gmail": [],
    "status": 400,
  },
  "removed": {
    "body": {
      "configured": false,
    },
    "db": [
      "memberships: select(role) eq(user_id,user-1) eq(organization_id,org-1)",
      "organization_google_oauth_clients: delete() eq(organization_id,org-1)",
      "gmail_connections: delete() eq(organization_id,org-1)",
    ],
    "gmail": [],
    "status": 200,
  },
}
`;

exports[`the Gmail function > starts a connection: through the shared connector, or the organisation's own client 1`] = `
{
  "badReturn": {
    "body": {
      "error": "returnUrl must be the app callback page",
    },
    "db": [
      "memberships: select(id) eq(user_id,user-1) eq(organization_id,org-1)",
    ],
    "gmail": [],
    "status": 400,
  },
  "noClient": {
    "body": {
      "error": "oauth_client_not_configured",
    },
    "db": [
      "memberships: select(id) eq(user_id,user-1) eq(organization_id,org-1)",
    ],
    "gmail": [],
    "status": 409,
  },
  "noReturn": {
    "body": {
      "error": "returnUrl is required",
    },
    "db": [],
    "gmail": [],
    "status": 400,
  },
  "own": {
    "starts": "https://accounts.google.com/o/oauth2/v2/auth",
    "status": 200,
  },
  "shared": {
    "body": {
      "authorizationUrl": "https://gateway/authorize?u=user-1&r=https://app/gmail-callback.html&k=plain:old",
    },
    "db": [
      "memberships: select(id) eq(user_id,user-1) eq(organization_id,org-1)",
      "gmail_connections: select(connection_key_encrypted) eq(user_id,user-1) is(organization_id,object)",
    ],
    "gmail": [],
    "status": 200,
  },
}
`;
