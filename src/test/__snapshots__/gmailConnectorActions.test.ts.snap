exports[`the Gmail function > reads a search's career pages, and says why one told it nothing 1`] = `
{
  "noQuery": {
    "body": {
      "error": "queryId is required",
    },
    "db": [
      "memberships: select(id) eq(user_id,user-1) eq(organization_id,org-1)",
    ],
    "gmail": [],
    "status": 400,
  },
  "none": {
    "body": {
      "links": [],
      "pages": [],
    },
    "db": [
      "memberships: select(id) eq(user_id,user-1) eq(organization_id,org-1)",
      "gmail_import_queries: select(id, career_pages) eq(id,q) eq(organization_id,org-1)",
    ],
    "gmail": [],
    "status": 200,
  },
  "notOurs": {
    "body": {
      "error": "forbidden: no such saved search in this organization",
    },
    "db": [
      "memberships: select(id) eq(user_id,user-1) eq(organization_id,org-1)",
      "gmail_import_queries: select(id, career_pages) eq(id,q) eq(organization_id,org-1)",
    ],
    "gmail": [],
    "status": 403,
  },
  "pages": {
    "body": {
      "links": [],
      "pages": [
        {
          "error": "This page is not one Agilefant knows how to read.",
          "inLists": 0,
          "messageId": "page:https://unknown.example/careers",
          "name": "https://unknown.example/careers",
          "skipped": 0,
          "total": 0,
          "url": "https://unknown.example/careers",
        },
      ],
    },
    "db": [
      "memberships: select(id) eq(user_id,user-1) eq(organization_id,org-1)",
      "gmail_import_queries: select(id, career_pages) eq(id,q) eq(organization_id,org-1)",
      "career_page_seen_postings: select(url) eq(query_id,q)",
    ],
    "gmail": [],
    "status": 200,
  },
}
`;

